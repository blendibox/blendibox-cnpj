{
  "manifest_version": 3,
  "name": "Busca de Empresa - Blendibox",
  "version": "1.0.0",
  "description": "Consulte CNPJ em qualquer página. Detecta CNPJs automaticamente e mostra a empresa ao passar o mouse.",
  "default_locale": "pt_BR",
  "permissions": ["storage"],
  "host_permissions": [
    "https://buscador-empresas-blendibox.blendibox.workers.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Busca de Empresa - Blendibox"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
