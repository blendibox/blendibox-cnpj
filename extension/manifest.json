{
  "manifest_version": 3,
  "name": "Busca de Empresa - Blendibox",
  "version": "1.0.1",
  "description": "Consulte CNPJ em qualquer página. Detecta CNPJs automaticamente e mostra a empresa ao passar o mouse.",
  "permissions": ["storage", "sidePanel", "geolocation"],
  "host_permissions": [
    "https://buscador-empresas-blendibox.blendibox.workers.dev/*",
    "https://comprar.blendibox.com.br/*"
  ],
  "action": {
    "default_title": "Busca de Empresa - Blendibox (abrir painel)"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["common.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
